
// Zoho Books Invoice Sync Workflow
//
// This workflow creates and updates invoices in
// Zoho Books whenever a sales entry is submitted.
//
// What this workflow does:
// - prepares invoice data for Zoho Books
// - maps customer and product details
// - sends line items with quantity and rate
// - applies GST or IGST dynamically
// - applies item-level discounts
// - creates new invoices in Zoho Books
// - updates existing invoices during edits
// - stores Books Invoice ID in Creator
// - automatically marks invoice as sent
//
// This workflow helps maintain synchronization
// between Zoho Creator sales entries and
// Zoho Books accounting records.
//
// -----------------------------------------------------------------------


org_id = "60070740114";
org_state = "Kerala";

salesMap = Map();
// customer mapping
salesMap.put("customer_id",input.Customer.Customer_ID.toString());
if(input.Sale_Number != null)
{
salesMap.put("reference_number",input.Sale_Number.toString());
}

salesMap.put("date",input.Date_field.toString("yyyy-MM-dd"));
lineItemsList = List();
for each item in input.Items
{
if(item.Product != null && item.Product.Item_ID != null)
{
lineMap = Map();
// item mapping
lineMap.put("item_id",item.Product.Item_ID.toString());
// item selling price
lineMap.put("rate",ifnull(item.Product.mrp,0));
// item quantity
lineMap.put("quantity",ifnull(item.Qty,0));
// GST / IGST Logic
CustomerRec = Customer_Master[ID == input.Customer];
customer_state = ifnull(CustomerRec.Customer_State,"");
// same state = GST
if(org_state == customer_state)
{
taxRec = GST_Master[Tax_Type == "GST" && Tax_Percentage == item.Product.Tax_Percentage1.Tax_Percentage];
}
// different state = IGST
else
{
taxRec = GST_Master[Tax_Type == "IGST" && Tax_Percentage == item.Product.Tax_Percentage1.Tax_Percentage];
}
// apply tax to invoice item
if(taxRec != null)
{
lineMap.put("tax_id",taxRec.ZB_ID);
}
// Discount Logic
if(item.Discount_perc != null && item.Discount_perc != 0)
{
lineMap.put("discount",item.Discount_perc.toString() + "%");
lineMap.put("discount_type","entity_level");
lineMap.put("is_discount_before_tax",true);
}
// add item to invoice
lineItemsList.add(lineMap);
}
}
// attach all line items to invoice
salesMap.put("line_items",lineItemsList);
// Create new invoice if invoice does not exist
if(input.Books_Invoice_ID == null || input.Books_Invoice_ID == "")
{
response = zoho.books.createRecord("Invoices",org_id,salesMap,"zohobooksazza");
}
// Update existing invoice during edits
else
{
salesMap.put("bulk_update",true);
response = zoho.books.updateRecord("Invoices",org_id,input.Books_Invoice_ID.toString(),salesMap,"zohobooksazza");
}
// save invoice id and mark invoice as sent
if(response.get("code") == 0)
{
invoice_id = response.get("invoice").get("invoice_id");
input.Books_Invoice_ID = invoice_id;
statusResp = zoho.books.markStatus("Invoices",org_id,invoice_id,"sent","zohobooksazza");
info statusResp;

info response;
}


// Sales Stock Validation & Total Calculation Workflow
// ---------------------------------------------------------------
//
// This workflow validates available stock before
// allowing sales quantity entry.
//
// What this workflow does:
// - checks current stock for selected batch
// - prevents selling more than available stock
// - shows alert if stock is insufficient
// - auto calculates subtotal
// - calculates discount amount
// - calculates GST tax
// - calculates final item total
// - updates overall invoice totals automatically
//
// This workflow helps prevent negative inventory
// and improves billing accuracy.
//
// SALES FORM- USER INPUT OF QTY (TRIGGER)
//--------------------------------------------------------------------

// default available stock
available_stock = 0;


// fetch selected inventory batch
rec = Product_Inventory[ID == row.Batch_Number];

// get current stock
if(rec.count() > 0)
{
available_stock = rec.Current_Stock;
}


// validate stock before allowing quantity
if(row.Qty > available_stock)
{
alert "Only " + available_stock + " items available!";

row.Qty = null;
}


// initialize totals
total_qty = 0;

sub_total = 0;

total_discount = 0;

total_tax = 0;


// loop through all sales items
for each roww in input.Items
{
if(roww.Product != null)
{
// fetch item details
itemRec = Item_Master[ID == roww.Product];

// auto fill selling price
roww.rate1 = itemRec.mrp;

// auto fill GST percentage
roww.Tax_Percentage = itemRec.Tax_Percentage1.Tax_Percentage;

rate = ifnull(roww.rate1,0);

qty = ifnull(roww.Qty,0);

disc_per = ifnull(roww.Discount_perc,0);

tax_per = ifnull(roww.Tax_Percentage,0);


// calculate subtotal
amount = rate * qty;

roww.Sub_Total = amount;


// calculate discount
disc_amt = (amount * disc_per) / 100;

roww.Discount_Amount = disc_amt;


// taxable amount
taxable = amount - disc_amt;


// calculate GST tax
tax_amt = (taxable * tax_per) / 100;

roww.Total_Tax = tax_amt;


// final item total
roww.Total = taxable + tax_amt;


// overall totals
total_qty = total_qty + qty;

sub_total = sub_total + amount;

total_discount = total_discount + disc_amt;

total_tax = total_tax + tax_amt;
}
}


// update overall sales totals
input.Total_Qty = total_qty;

input.Sub_Total = sub_total;

input.Total_Discount = total_discount;

input.Total_Tax = total_tax;

input.Grand_Total1 = sub_total - total_discount + total_tax;

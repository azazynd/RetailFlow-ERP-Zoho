
// Sales Total Calculation & Batch Filter Workflow

//
// This workflow handles automatic calculations inside
// the Sales form.
//
// What this workflow does:
// - auto fetches product selling price
// - auto fetches GST percentage from item master
// - calculates subtotal for each item
// - calculates discount amount
// - calculates GST tax amount
// - calculates final item total
// - calculates overall sales totals
// - updates grand total automatically
// - filters batch numbers based on selected product
//
// This workflow reduces manual calculation errors
// and improves billing accuracy inside the ERP.
//
// USE SAME CODE FOR SALE FORM------>USER INPUT OF DISCOUNT PERCENTAGE (TRIGGER)
//-------------------------------------------------------------------------


total_qty = 0;
sub_total = 0;
total_discount = 0;
total_tax = 0;

for each roww in input.Items
{
if(roww.Product != null)
{
// fetch product details from item master
itemRec = Item_Master[ID == roww.Product];

roww.rate1 = itemRec.mrp;
// auto fill GST percentage
roww.Tax_Percentage = itemRec.Tax_Percentage1.Tax_Percentage;
rate = ifnull(roww.rate1,0);
qty = ifnull(roww.Qty,0);
disc_per = ifnull(roww.Discount_perc,0);
tax_per = ifnull(roww.Tax_Percentage,0);
// calculate subtotal
amount = rate * qty;
roww.Sub_Total = amount;
// calculate discount amount
disc_amt = (amount * disc_per) / 100;
roww.Discount_Amount = disc_amt;
// calculate taxable amount
taxable = amount - disc_amt;

// calculate GST tax
tax_amt = (taxable * tax_per) / 100;
roww.Total_Tax = tax_amt;

// calculate final item total
roww.Total = taxable + tax_amt;
// overall totals
total_qty = total_qty + qty;

sub_total = sub_total + amount;

total_discount = total_discount + disc_amt;

total_tax = total_tax + tax_amt;
}
}
// update overall sales totals
input.Total_Qty = total_qty;
input.Sub_Total = sub_total;
input.Total_Discount = total_discount;
input.Total_Tax = total_tax;
input.Grand_Total1 = sub_total - total_discount + total_tax;
// Filters available batch numbers based on
// selected product.

// clear previous batch selection
clear row.Batch_Number;

// fetch inventory records for selected product
records = Product_Inventory[Product.ID == roww.Product.ID];

// add matching batches to dropdown
for each rec in records
{
roww.Batch_Number:ui.add(rec.ID);
}
